#!/bin/zsh

# สคริปต์เปิดเว็บ ApexDrive อัตโนมัติ (ดับเบิลคลิกเปิดได้ทันทีบน Mac)
cd "$(dirname "$0")/frontend"

echo "=========================================="
echo "🏎️   ApexDrive — Starting Web Server..."
echo "=========================================="

# รอ 1.5 วินาทีแล้วเปิดเว็บบนเบราว์เซอร์อัตโนมัติ
(sleep 1.5 && open "http://localhost:5173") &

# เริ่มต้นเซิร์ฟเวอร์
npm run dev
