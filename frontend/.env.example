# ApexDrive Frontend Environment Variables (Template)
# คัดลอกไฟล์นี้เป็น .env และกรอกค่าให้ครบถ้วน
# ⚠️ ห้ามใส่ API Key ที่เป็นความลับลงในตัวแปร VITE_ เด็ดขาด

VITE_WORKER_URL=https://apexdrive-chatbot.your-account.workers.dev
VITE_SEARCH_MODE=local
VITE_AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
VITE_DOCS_BASE=docs
